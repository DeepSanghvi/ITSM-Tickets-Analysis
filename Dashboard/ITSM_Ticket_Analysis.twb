      <column caption='SLA Breach Rate' datatype='real' name='[Calculation_1435803856821100544]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [resolution_time_hours] &gt; 24 THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([ticket_id])' />
